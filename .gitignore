# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (se regenera con npm ci)
node_modules/
.pnp
.pnp.js

# build web (se regenera con npm run build)
# OJO: con barra inicial = solo el dist/ de la raíz. Sin ella también ignoraría
# el dist/ del plugin vendorizado, que SÍ debe versionarse.
/dist/

# plataformas nativas (NO se versionan: se regeneran con `npx cap add android`)
# OJO: `cap add` crea la plantilla limpia. Hay que reaplicar a mano:
#  - AndroidManifest.xml (permisos + largeHeap)
#  - settings.gradle + libfacesdk/ (módulo envoltorio del .aar de FacePlugin)
#  - app/build.gradle (proguard-android-optimize.txt)
# Ver docs/integracion-faceplugin.md
android/
ios/

# testing
coverage/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# secrets: NUNCA subir keys (ElevenLabs, etc.)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# artefactos de build del plugin vendorizado (Gradle compila ahí por cap sync)
vendor/*/android/build/
vendor/*/android/.gradle/

# misc
.DS_Store
Thumbs.db
.nx/
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editores
.idea/
.vscode/*
!/.vscode/extensions.json
