# Plantilla de .env — copia este archivo a .env y coloca tus keys reales.
# (.env está en .gitignore: nunca commitear keys)
#
# Licencia del SDK facial (FacePlugin). La key va firmada contra el
# applicationId de android/app/build.gradle: si cambia el id, pide una nueva al
# proveedor con el machine code (FPMC1...) que muestra la pantalla /rostro.
VITE_FACEPLUGIN_LICENSE_ANDROID=
VITE_FACEPLUGIN_LICENSE_IOS=
