{
  "name": "capacitor-plan-seguro",
  "version": "0.0.1",
  "description": "Plugin demo: guarda el plan médico de forma segura + patrón callbacks→corrutinas (INGIF-1442)",
  "main": "dist/plugin.js",
  "types": "dist/definitions.d.ts",
  "scripts": {
    "build": "npm run clean && tsc && rollup -c",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "watch": "tsc --watch",
    "verify": "npm run build"
  },
  "keywords": ["capacitor", "plugin", "security", "demo"],
  "capacitor": { "ios": { "src": "ios" }, "android": { "src": "android" } },
  "peerDependencies": { "@capacitor/core": "^6.0.0 || ^7.0.0 || ^8.0.0" },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.9.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "rollup": "^4.30.1"
  },
  "files": ["dist/", "android/", "ios/"]
}
