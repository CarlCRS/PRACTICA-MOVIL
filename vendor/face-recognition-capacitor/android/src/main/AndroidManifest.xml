<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- largeHeap: el motor ONNX necesita heap grande. El manifest merger lo
         fusiona en la app: no hay que tocar AndroidManifest.xml a mano.
         (extractNativeLibs NO se puede fijar aquí: AGP lo inyecta desde
         packaging.jniLibs.useLegacyPackaging en app/build.gradle.) -->
    <application android:largeHeap="true" />
</manifest>
